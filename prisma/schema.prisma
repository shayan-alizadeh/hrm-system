generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  MANAGER
  EMPLOYEE
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(250)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @db.VarChar(50)
  lastName     String  @db.VarChar(50)
  nationalCode String? @unique @db.VarChar(10)
  mobile       String  @unique @db.VarChar(15)
  password     String
  isActive     Boolean @default(true)
  tokenVersion Int     @default(1)

  role RoleType @default(EMPLOYEE)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  refreshTokens RefreshToken[]
  attendances   Attendance[]
  payrolls      Payroll[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  contracts     Contract[]

  // mobile و nationalCode به‌واسطه @unique دارای ایندکس هستند.
  @@map("users")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.VarChar(36)
  tokenHash String @db.VarChar(255)

  userId Int
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade,map: "fk_refresh_token_user")

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  // پوشش جست‌وجوی نشست‌های کاربر و شرط revokedAt: null.
  // ستون ابتدایی، جست‌وجوی صرفاً بر اساس userId را نیز پوشش می‌دهد.
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_revoked")
  @@map("refresh_tokens")
}

model Attendance {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // تاریخ شمسی با قالب ثابت YYYY/MM/DD و ارقام انگلیسی.
  attendanceDate String    @db.VarChar(10)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  notes          String?   @db.VarChar(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // جست‌وجوی حضور یک کاربر در روز یا بازه تاریخی.
  // این ایندکس غیر یکتا است و چند نوبت حضور در یک روز را ممنوع نمی‌کند.
  @@index([userId, attendanceDate], map: "idx_attendances_user_date")
  @@map("attendances")
}

enum PayrollStatus {
  PENDING
  PAID
}

model Payroll {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  baseSalary      Float
  totalAllowances Float
  grossSalary     Float

  taxDeduction         Float
  insuranceDeduction   Float
  unpaidLeaveDeduction Float

  netSalary Float

  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // علاوه بر جلوگیری از فیش تکراری، جست‌وجوی کاربر و سال را پوشش می‌دهد.
  @@unique([userId, year, month])
  @@map("payrolls")
}

model TaxRule {
  id         Int    @id @default(autoincrement())
  year       Int
  minIncome  Float
  maxIncome  Float?
  percentage Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // دریافت پله‌های یک سال به ترتیب حداقل درآمد.
  // جلوگیری از هم‌پوشانی پله‌ها به اعتبارسنجی جداگانه نیاز دارد.
  @@index([year, minIncome], map: "idx_tax_rules_year_min_income")
  @@map("tax_rules")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MARRIAGE
  BEREAVEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model LeaveBalance {
  id     Int @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade,map: "fk_leave_balance_user")

  year           Int
  totalDays      Float @default(26)
  usedDays       Float @default(0)
  usedSickDays   Float @default(0)
  usedUnpaidDays Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس یکتا برای دریافت موجودی سالانه هر کاربر کافی است.
  @@unique([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType LeaveType

  // تاریخ‌های شمسی با قالب ثابت YYYY/MM/DD و ارقام انگلیسی.
  startDate String @db.VarChar(10)
  endDate   String @db.VarChar(10)

  totalDays Float

  reason String      @db.Text
  status LeaveStatus @default(PENDING)

  managerNote String?   @db.Text
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // سوابق کاربر و محدودکردن جست‌وجو بر اساس تاریخ شروع.
  @@index([userId, startDate], map: "idx_leave_requests_user_start")

  // فهرست مدیریتی با وضعیت مشخص، مرتب‌شده بر اساس تاریخ شروع.
  @@index([status, startDate], map: "idx_leave_requests_status_start")

  @@map("leave_requests")
}

model Holiday {
  id    Int    @id @default(autoincrement())
  date  String @unique @db.VarChar(10)
  title String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // date به‌واسطه @unique دارای ایندکس است.
  @@map("holidays")
}

enum ContractType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  PROBATION
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contractNo String         @unique @db.VarChar(50)
  jobTitle   String         @db.VarChar(100)
  type       ContractType
  status     ContractStatus @default(ACTIVE)

  // تاریخ‌های شمسی با قالب ثابت YYYY/MM/DD و ارقام انگلیسی.
  startDate String @db.VarChar(10)
  endDate   String @db.VarChar(10)

  baseSalary       Float
  housingAllowance Float @default(0)
  foodAllowance    Float @default(0)
  childAllowance   Float @default(0)

  insuranceNo String? @db.VarChar(20)
  fileUrl     String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // قراردادهای یک کاربر با وضعیت مشخص و فیلتر یا ترتیب تاریخ شروع.
  @@index([userId, status, startDate], map: "idx_contracts_user_status_start")
  @@map("contracts")
}