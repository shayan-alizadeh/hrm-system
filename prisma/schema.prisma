// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  MANAGER
  EMPLOYEE
}

enum PayrollStatus {
  PENDING
  PAID
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(250)

  // رابطه یک به چند با کاربران
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments") // نام جدول در دیتابیس
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @db.VarChar(50) // اضافه شده
  lastName     String  @db.VarChar(50) // اضافه شده
  nationalCode String? @unique @db.VarChar(10) // اضافه شده برای احراز هویت و بیمه
  mobile       String  @unique @db.VarChar(15)
  password     String
  isActive     Boolean @default(true) // برای مدیریت کارمندان سابق
  tokenVersion Int      @default(1)

  role RoleType @default(EMPLOYEE)

  // کلید خارجی دپارتمان
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  refreshTokens RefreshToken[]
  attendances   Attendance[]
  payrolls      Payroll[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  

  @@map("users")
}

model RefreshToken {
  id        Int    @id @default(autoincrement())
  tokenHash String @db.VarChar(255) // طول مشخص برای هش
  userId    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade , map: "fk_refresh_token_user") // اضافه شدن Cascade برای خروج خودکار در صورت حذف کاربر

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
}

model Attendance {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendanceDate String    @db.VarChar(10) // مثال: 1405/06/01
  checkInTime    DateTime?
  checkOutTime   DateTime?
  notes          String?   @db.VarChar(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}

model Payroll {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  payPeriod String @db.VarChar(7) // مثال: 1405-06

  // تغییر به BigInt برای جلوگیری از Overflow مبالغ ریالی
  baseSalary  BigInt
  bonuses     BigInt @default(0)
  deductions  BigInt @default(0) // اصلاح املایی (deduction -> deductions)
  totalAmount BigInt

  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?
  notes       String?       @db.VarChar(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payrolls")
}

model TaxRule {
  id         Int      @id @default(autoincrement())
  year       Int      // مثال: 1404
  minIncome  BigInt   // کف پله (ریال)
  maxIncome  BigInt?  // سقف پله - قرار دادن null به معنای بی‌نهایت (بدون سقف) است
  percentage Float    // درصد مالیات این پله (مثلاً 10)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tax_rules")
}

// انواع مرخصی در قانون کار ایران
enum LeaveType {
  ANNUAL       // استحقاقی (سالانه)
  SICK         // استعلاجی (بیماری)
  UNPAID       // بدون حقوق
  MARRIAGE     // ازدواج
  BEREAVEMENT  // سوگ (فوت بستگان)
}

// وضعیت درخواست مرخصی
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED    // لغو شده توسط خود کارمند قبل از تایید مدیر
}

model LeaveBalance {
  id          Int      @id @default(autoincrement())
  userId      Int      
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade,map: "fk_leave_balance_user")
  
  year        Int      // سال شمسی، مثلا 1404
  totalDays   Float    @default(26) // کل مرخصی استحقاقی سال (طبق قانون ۲۶ روز)
  usedDays    Float    @default(0)  // روزهای استفاده شده
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leaveType   LeaveType
  startDate   String      @db.VarChar(10) // فرمت: 1404/09/01
  endDate     String      @db.VarChar(10) // فرمت: 1404/09/03
  
  // برای محاسبه کسر از موجودی (چون ممکن است جمعه‌ها وسط مرخصی باشد و حساب نشود)
  totalDays   Float       
  
  reason      String      @db.Text
  status      LeaveStatus @default(PENDING)
  
  // فیلدهای مربوط به مدیر (چه کسی و کی تایید/رد کرد؟)
  managerNote String?     @db.Text
  resolvedAt  DateTime?   // زمان تایید یا رد

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        String   @unique @db.VarChar(10) // فرمت: 1404/01/01 (یونیک برای جلوگیری از ثبت تکراری)
  title       String   @db.VarChar(100)        // مثلا: عید نوروز
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}