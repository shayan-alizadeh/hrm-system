generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// کاربران و ساختار سازمانی
// -----------------------------------------------------------------------------

enum RoleType {
  MANAGER
  EMPLOYEE
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(250)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @db.VarChar(50)
  lastName     String  @db.VarChar(50)
  nationalCode String? @unique @db.VarChar(10)
  mobile       String  @unique @db.VarChar(15)
  password     String
  isActive     Boolean @default(true)
  tokenVersion Int     @default(1)

  role RoleType @default(EMPLOYEE)

  departmentId Int?

  // انتقال یا خارج کردن کاربران از دپارتمان باید پیش از حذف آن انجام شود.
  department Department? @relation(fields: [departmentId],references: [id],onDelete: Restrict)

  refreshTokens RefreshToken[]
  attendances   Attendance[]
  payrolls      Payroll[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  contracts     Contract[]

  // شمارش و دریافت اعضای دپارتمان.
  // هنگام migration، ایندکس خودکار موجود برای FK نیز بررسی شود.
  @@index([departmentId], map: "idx_users_department")

  // mobile و nationalCode از طریق @unique ایندکس دارند.
  @@map("users")
}

// -----------------------------------------------------------------------------
// نشست‌های احراز هویت
// -----------------------------------------------------------------------------

model RefreshToken {
  id        String @id @default(uuid()) @db.VarChar(36)
  tokenHash String @db.VarChar(255)

  userId Int
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade,map: "fk_refresh_token_user")

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  // ابطال نشست‌های فعال کاربر و جست‌وجوی تمام نشست‌های همان کاربر.
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_revoked")

  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// حضور و غیاب
// -----------------------------------------------------------------------------

model Attendance {
  id     Int @id @default(autoincrement())
  userId Int

  // حذف کاربر نباید سوابق حضور و غیاب را حذف کند.
  user User @relation(fields: [userId],references: [id],onDelete: Restrict)

  // تاریخ شمسی با قالب ثابت YYYY/MM/DD و ارقام انگلیسی.
  attendanceDate String    @db.VarChar(10)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  notes          String?   @db.VarChar(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // گزارش روزانه یا بازه تاریخی یک کارمند.
  // غیر یکتا است؛ چند نوبت ورود و خروج در یک روز مجاز باقی می‌ماند.
  @@index([userId, attendanceDate], map: "idx_attendances_user_date")

  // جست‌وجوی تردد باز با شرط checkOutTime: null.
  // این ایندکس به‌تنهایی یکتایی تردد باز را تضمین نمی‌کند.
  @@index([userId, checkOutTime], map: "idx_attendances_user_checkout")

  @@map("attendances")
}

// -----------------------------------------------------------------------------
// حقوق و دستمزد
// -----------------------------------------------------------------------------

enum PayrollStatus {
  PENDING
  PAID
}

model Payroll {
  id     Int @id @default(autoincrement())
  userId Int

  // حذف کاربر دارای فیش حقوقی باید مسدود شود.
  user User @relation(fields: [userId],references: [id],onDelete: Restrict)

  year  Int
  month Int

  // نوع Float فعلاً برای سازگاری با سرویس‌های فعلی حفظ شده است.
  // مهاجرت مالی به Decimal باید همراه با اصلاح محاسبات و خروجی API باشد.
  baseSalary      Float
  totalAllowances Float
  grossSalary     Float

  taxDeduction         Float
  insuranceDeduction   Float
  unpaidLeaveDeduction Float

  netSalary Float

  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // هر کارمند در یک سال و ماه، حداکثر یک فیش دارد.
  // ترتیب فیلدها جست‌وجوی userId و userId + year را نیز پوشش می‌دهد.
  @@unique([userId, year, month])

  @@map("payrolls")
}

model TaxRule {
  id         Int    @id @default(autoincrement())
  year       Int
  minIncome  Float
  maxIncome  Float?
  percentage Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // دریافت پله‌های یک سال به ترتیب کف درآمد.
  // عدم هم‌پوشانی پله‌ها همچنان در تراکنش سرویس بررسی می‌شود.
  @@index([year, minIncome], map: "idx_tax_rules_year_min_income")

  @@map("tax_rules")
}

// -----------------------------------------------------------------------------
// مرخصی
// -----------------------------------------------------------------------------

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MARRIAGE
  BEREAVEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model LeaveBalance {
  id     Int @id @default(autoincrement())
  userId Int

  user User @relation(fields: [userId],references: [id],onDelete: Restrict,map: "fk_leave_balance_user")

  year Int

  // سهمیه پیش‌فرض فعلی برنامه؛ بیانگر قاعده حقوقی عمومی نیست.
  totalDays     Float @default(26)
  usedDays      Float @default(0)
  usedSickDays  Float @default(0)
  usedUnpaidDays Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // برای هر کارمند در هر سال، یک موجودی ثبت می‌شود.
  @@unique([userId, year])

  @@map("leave_balances")
}

model LeaveRequest {
  id     Int @id @default(autoincrement())
  userId Int

  user User @relation(fields: [userId],references: [id],onDelete: Restrict)

  leaveType LeaveType

  // مقایسه رشته‌ای فقط با قالب ثابت و تاریخ معتبر قابل اتکاست.
  startDate String @db.VarChar(10)
  endDate   String @db.VarChar(10)

  totalDays Float

  reason String      @db.Text
  status LeaveStatus @default(PENDING)

  managerNote String?   @db.Text
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // فیلتر تاریخ برای یک کارمند بدون الزام به تعیین وضعیت.
  @@index([userId, startDate], map: "idx_leave_requests_user_start")

  // بررسی درخواست‌های در انتظار یا تأییدشده کارمند و محدود کردن بازه.
  // شرط endDate ممکن است پس از پیمایش ایندکس ارزیابی شود.
  @@index([userId, status, startDate],map: "idx_leave_requests_user_status_start")

  // فیلتر مدیریتی بر اساس وضعیت و تاریخ شروع.
  // این ایندکس مرتب‌سازی createdAt را تضمین نمی‌کند.
  @@index([status, startDate], map: "idx_leave_requests_status_start")

  @@map("leave_requests")
}

model Holiday {
  id    Int    @id @default(autoincrement())
  date  String @unique @db.VarChar(10)
  title String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // قید یکتای date برای جست‌وجوی تاریخ و بازه تاریخی نیز قابل استفاده است.
  @@map("holidays")
}

// -----------------------------------------------------------------------------
// قراردادها
// -----------------------------------------------------------------------------

enum ContractType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  PROBATION
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id     Int @id @default(autoincrement())
  userId Int

  user User @relation(fields: [userId],references: [id],onDelete: Restrict)

  contractNo String         @unique @db.VarChar(50)
  jobTitle   String         @db.VarChar(100)
  type       ContractType
  status     ContractStatus @default(ACTIVE)

  startDate String @db.VarChar(10)
  endDate   String @db.VarChar(10)

  // واحد قراردادی API فعلی: ریال.
  // داده‌های قدیمی باید جداگانه از نظر واحد پول بررسی شوند.
  baseSalary       Float
  housingAllowance Float @default(0)
  foodAllowance    Float @default(0)
  childAllowance   Float @default(0)

  insuranceNo String? @db.VarChar(20)
  fileUrl     String? @db.VarChar(191)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // قراردادهای کارمند با وضعیت مشخص و شرط تاریخ شروع.
  // این ایندکس قید «فقط یک قرارداد فعال» نیست.
  @@index([userId, status, startDate],map: "idx_contracts_user_status_start")

  @@map("contracts")
}