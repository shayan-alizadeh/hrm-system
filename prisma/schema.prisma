// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  MANAGER
  EMPLOYEE
}


model Department {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(250)

  // رابطه یک به چند با کاربران
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments") // نام جدول در دیتابیس
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @db.VarChar(50) // اضافه شده
  lastName     String  @db.VarChar(50) // اضافه شده
  nationalCode String? @unique @db.VarChar(10) // اضافه شده برای احراز هویت و بیمه
  mobile       String  @unique @db.VarChar(15)
  password     String
  isActive     Boolean @default(true) // برای مدیریت کارمندان سابق
  tokenVersion Int      @default(1)

  role RoleType @default(EMPLOYEE)

  // کلید خارجی دپارتمان
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  refreshTokens RefreshToken[]
  attendances   Attendance[]
  payrolls      Payroll[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  contracts Contract[]
  

  @@map("users")
}

model RefreshToken {
  id        Int    @id @default(autoincrement())
  tokenHash String @db.VarChar(255) // طول مشخص برای هش
  userId    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade , map: "fk_refresh_token_user") // اضافه شدن Cascade برای خروج خودکار در صورت حذف کاربر

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
}

model Attendance {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendanceDate String    @db.VarChar(10) // مثال: 1405/06/01
  checkInTime    DateTime?
  checkOutTime   DateTime?
  notes          String?   @db.VarChar(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}


enum PayrollStatus {
  PENDING   // فیش صادر شده و در انتظار بررسی/واریز است
  PAID      // حقوق به حساب کارمند واریز شده است
}

model Payroll {
  id                   Int      @id @default(autoincrement())
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  year                 Int      // مثلا 1404
  month                Int      // مثلا 8 (آبان)
  
  // درآمدهای این ماه
  baseSalary           Float
  totalAllowances      Float    // جمع حق مسکن، بن کارگری و حق اولاد
  grossSalary          Float    // حقوق ناخالص (جمع کل درآمدها)
  
  // کسورات
  taxDeduction         Float    // کسر مالیات
  insuranceDeduction   Float    // کسر بیمه سهم کارمند (7%)
  unpaidLeaveDeduction Float    // کسر مرخصی بدون حقوق
  
  // مبلغ نهایی قابل پرداخت
  netSalary            Float   

  status               PayrollStatus @default(PENDING)
  paymentDate          DateTime?     // تاریخ و زمان دقیق واریز بانکی 
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // یک کارمند در هر ماه فقط یک فیش حقوقی می‌تواند داشته باشد
  @@unique([userId, year, month])
  @@map("payrolls")
}

model TaxRule {
  id         Int      @id @default(autoincrement())
  year       Int      // مثال: 1404
  minIncome  Float    
  maxIncome  Float?   
  percentage Float    // درصد مالیات این پله (مثلاً 10)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tax_rules")
}

// انواع مرخصی در قانون کار ایران
enum LeaveType {
  ANNUAL       // استحقاقی (سالانه)
  SICK         // استعلاجی (بیماری)
  UNPAID       // بدون حقوق
  MARRIAGE     // ازدواج
  BEREAVEMENT  // سوگ (فوت بستگان)
}

// وضعیت درخواست مرخصی
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED    // لغو شده توسط خود کارمند قبل از تایید مدیر
}

model LeaveBalance {
  id          Int      @id @default(autoincrement())
  userId      Int      
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade,map: "fk_leave_balance_user")
  
  year        Int      // سال شمسی، مثلا 1404
  totalDays   Float    @default(26) // کل مرخصی استحقاقی سال (طبق قانون ۲۶ روز)
  usedDays    Float    @default(0)  // مرخصی استحقاقی مصرف شده
  usedSickDays   Float    @default(0) // مرخصی استعلاجی مصرف شده
  usedUnpaidDays Float    @default(0) // مرخصی بدون حقوق مصرف شده
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leaveType   LeaveType
  startDate   String      @db.VarChar(10) // فرمت: 1404/09/01
  endDate     String      @db.VarChar(10) // فرمت: 1404/09/03
  
  // برای محاسبه کسر از موجودی (چون ممکن است جمعه‌ها وسط مرخصی باشد و حساب نشود)
  totalDays   Float       
  
  reason      String      @db.Text
  status      LeaveStatus @default(PENDING)
  
  // فیلدهای مربوط به مدیر (چه کسی و کی تایید/رد کرد؟)
  managerNote String?     @db.Text
  resolvedAt  DateTime?   // زمان تایید یا رد

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        String   @unique @db.VarChar(10) // فرمت: 1404/01/01 (یونیک برای جلوگیری از ثبت تکراری)
  title       String   @db.VarChar(100)        // مثلا: عید نوروز
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}


enum ContractType {
  FULL_TIME   // تمام وقت
  PART_TIME   // پاره وقت
  INTERNSHIP  // کارآموزی
  PROBATION   // آزمایشی (سه ماهه)
}

enum ContractStatus {
  ACTIVE      // فعال
  EXPIRED     // پایان یافته
  TERMINATED  // فسخ شده
}

// مدل اصلی قرارداد
model Contract {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contractNo    String         @unique @db.VarChar(50) // شماره یکتای قرارداد در سازمان
  jobTitle      String         @db.VarChar(100)        // عنوان شغلی (مثلاً توسعه دهنده بک‌اند)
  type          ContractType
  status        ContractStatus @default(ACTIVE)

  startDate     String         @db.VarChar(10) // 1404/01/01
  endDate       String         @db.VarChar(10) // 1404/12/29
  
  // اطلاعات مالی برای استفاده اتوماتیک در ماژول Payroll
  baseSalary    Float          // حقوق پایه
  housingAllowance Float       @default(0) // حق مسکن
  foodAllowance    Float       @default(0) // حق بن کارگری (خواربار)
  childAllowance   Float       @default(0) // حق اولاد
  
  insuranceNo   String?        @db.VarChar(20) // شماره بیمه تامین اجتماعی
  
  fileUrl       String?        // مسیر فایل اسکن شده (مربوط به آپلود فایل در آینده)
  notes         String?        @db.Text

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("contracts")
}